{
  "name": "vue-note-bar",
  "version": "0.1.0",
  "description": "A Vue 3 top-bar component (NotebookBar) to switch / create / delete notebooks and trigger backend config & manual save. No data layer, no storage.",
  "type": "module",
  "main": "dist/vue-note-bar.umd.cjs",
  "module": "dist/vue-note-bar.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-note-bar.js",
      "require": "./dist/vue-note-bar.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "notebook",
    "note-bar",
    "component",
    "switch"
  ],
  "author": "weijia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weijia/vue-note-bar.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.4.0"
  }
}
